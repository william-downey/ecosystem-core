      }
    },
    "northern_afterlight": {
      "dropbox": {
        "root_folder": "/Northern Afterlight/Assets",
        "structure": [
          "Project Name",
          "Release",
          "Archive"
        ]
      },
      "samply": {
        "enabled": false
      }
    }
  }
}
