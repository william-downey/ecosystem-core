{
  "delivery_map": {
    "fifty_seven_mastering": {
      "dropbox": {
        "root_folder": "/Fifty-Seven Mastering/Clients",
        "structure": [
          "Client Name",
          "Project Name",
          "Deliverables"
        ]
      },
      "samply": {
        "project_naming": "FSM-{client_name}-{project_name}-{job_id}",
        "link_usage": "client_delivery_only",
