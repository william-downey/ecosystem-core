{
  "name": "mastering_delivery_ready",
  "source": "supabase.mastering_jobs.jobs",
  "trigger": "job_status_changed",
  "conditions": {
    "status": "ready_for_delivery",
    "brand": "Fifty-Seven Mastering"
  },
  "actions": [
    "create_dropbox_folder",
    "create_samply_link",
    "update_job_delivery_links",
    "send_email:delivery_ready"
  ],
  "make_modules": [
    {
      "module": "supabase:WatchRecords",
      "table": "jobs",
      "event": "update"
    },
    {
      "module": "filter",
      "conditions": {
        "status": "ready_for_delivery",
        "brand": "Fifty-Seven Mastering"
      }
    },
    {
      "module": "dropbox:CreateFolder",
      "root_folder": "/Fifty-Seven Mastering/Clients",
      "structure": ["Client Name", "Project Name", "Deliverables"]
    },
    {
      "module": "samply:CreateProject",
      "project_naming": "FSM-{client_name}-{project_name}-{job_id}",
      "link_usage": "client_delivery_only",
      "versioning": "per_job"
    },
    {
      "module": "supabase:UpdateRecord",
      "table": "jobs",
      "field": "delivery_links"
    },
    {
      "module": "postmark:SendEmail",
      "template": "fsm_delivery_ready"
    }
  ]
}
